<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>DriveLayer</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Declares up front that this build contains no non-exempt encryption, so App
	     Store Connect stops asking the export-compliance question on every upload.
	     Answering it by hand each time is a step that gets skipped or answered
	     wrongly in a hurry.

	     False is the accurate answer, and it was checked rather than assumed: the app
	     implements no cryptography at all - no CryptoKit, no CommonCrypto, no SecKey,
	     no AES or SHA, and no third-party packages that could bring any in. The only
	     encryption anywhere near it is iOS file protection on stored documents and
	     telemetry, which is the operating system encrypting data at rest and is
	     explicitly exempt.

	     This has to be revisited if that ever stops being true - notably if cloud
	     sync (V3, opt-in and encrypted) is ever built, which would change the
	     answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The icon lives in Assets.xcassets. This key names the icon set inside it and
	     is what App Store validation looks for: an app built against the iOS 11+ SDK
	     is rejected without it, whatever the catalog contains. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<key>UILaunchScreen</key>
	<dict/>

	<!-- iPhone only (1 = iPhone/iPod, 2 = iPad). Stated here as well as in
	     TARGETED_DEVICE_FAMILY because this is the value Apple's validator reads,
	     and the previous upload was rejected for not supporting iPad multitasking
	     while the build setting said iPhone. Declaring the device family in the
	     plist removes the ambiguity.

	     The rejection offered a second route - declare all four orientations - and
	     that would be untrue. DriveLayer is a portrait phone app used in a car
	     mount; claiming landscape would ship a layout nobody has designed. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>

	<!-- The scheme widgets, shortcuts and CarPlay use to name a screen. The set of
	     destinations it accepts is defined in DeepLink.swift and nowhere else. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.drivelayer.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>drivelayer</string>
			</array>
		</dict>
	</array>

	<!-- Permission copy. Each one says what the app does with the data and, where
	     relevant, that it stays on the device. Vague strings get apps rejected and,
	     more importantly, are how users end up denying a permission they'd have
	     granted if they understood it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DriveLayer uses your location to record drives, measure terrain and gradient, and work out where weather changes on the road ahead. Your location stays on this device.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Allowing location all the time lets DriveLayer start and finish recording a drive on its own, without you opening the app. Your location stays on this device and is never uploaded.</string>
	<key>NSMotionUsageDescription</key>
	<string>DriveLayer uses the barometer for accurate altitude, which is what makes road gradient meaningful, and can notice unusually rough road surfaces.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DriveLayer connects to a Bluetooth OBD-II adapter to read your vehicle's engine data. It only ever reads — it never sends commands that change anything in your car.</string>
	<key>NSCameraUsageDescription</key>
	<string>DriveLayer can scan documents like your insurance or registration into the glovebox. Scans are stored on this device with file protection and are never uploaded.</string>

	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>

	<!-- WeatherKit needs a paid capability on the developer account. Until it is
	     enabled here, the app says weather is not configured and everything else
	     keeps working. See docs/ARCHITECTURE.md. -->
	<key>DLWeatherKitEnabled</key>
	<false/>

	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>

	<!-- CarPlay: the scene role below is deliberately absent until Apple grants the
	     driving-task entitlement. The CarPlay code ships and compiles; enabling it is
	     two documented steps in docs/CARPLAY.md. -->
</dict>
</plist>
