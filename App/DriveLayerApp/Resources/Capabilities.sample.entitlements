<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements that need Apple's approval before they can be used.

  This file is a reference, not a build input: adding an entitlement the account has
  not been granted breaks code signing, so DriveLayer ships without them and works
  without them. Merge the keys you have been granted into DriveLayer.entitlements.

  - CarPlay driving task: requested at https://developer.apple.com/carplay/
    Also add the CarPlay scene role to Info.plist (see docs/CARPLAY.md).
  - WeatherKit: enabled on a paid developer account, and then set DLWeatherKitEnabled
    to true in Info.plist so the app stops reporting weather as unconfigured.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.drivelayer.app</string>
	</array>
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
